# OneApp Voice Attendance - Example Environment Configuration
# Copy this file to .env and configure your secrets before running the application:
#   cp .env.example .env

# REQUIRED: Secret key used to sign and verify JWT authentication tokens.
# Must be a secure random string (at least 32 characters in production).
# Example generation command: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars

# Host and Port settings (optional)
API_HOST=0.0.0.0
API_PORT=8000

